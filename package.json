{
  "name": "cert-manager",
  "version": "0.7.0",
  "description": "ACME and EST client with automatic certificate management for Node.js - keys in PEM, or behind an external signer (HSM, KMS, remote signing).",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ssl",
    "tls",
    "acme",
    "letsencrypt",
    "zerossl",
    "certificate",
    "https",
    "wildcard",
    "dns-01",
    "auto-renew",
    "rfc8555",
    "x509",
    "csr",
    "pem",
    "ecdsa",
    "hsm",
    "kms",
    "external-signer",
    "remote-signing",
    "est",
    "rfc7030",
    "pki"
  ],
  "author": {
    "name": "colocohen"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/colocohen/cert-manager.git"
  },
  "bugs": {
    "url": "https://github.com/colocohen/cert-manager/issues"
  },
  "homepage": "https://github.com/colocohen/cert-manager#readme",
  "dependencies": {
    "cryptographic-formats": "^0.1.0"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/colocohen"
    }
  ]
}
